# =====================================================================
# קובץ דוגמה למשתני סביבה.
# העתיקי אותו לקובץ בשם .env ומלאי ערכים אמיתיים.
# ⚠️ לעולם אל תעלי את קובץ .env ל-GitHub!
# =====================================================================

# development במחשב שלך, production בענן
NODE_ENV=development

# הפורט שהשרת מאזין לו (בענן – Render מגדיר אותו לבד)
PORT=3000

# כתובת החיבור ל-PostgreSQL
# במחשב: postgresql://USER:PASSWORD@localhost:5432/recipes_dev
# בענן (Neon): להעתיק מכפתור Connect בלוח הבקרה של Neon
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recipes_dev?schema=public"

# מחרוזת סודית ארוכה (לפחות 32 תווים) לחתימת ה-Token.
# אפשר ליצור כך:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-me-with-a-long-random-secret-at-least-32-chars"

# תוקף ה-Token: למשל 15m, 12h, 1d, 7d
JWT_EXPIRES_IN=1d

# כתובות האתר (React) שמותר להן לפנות לשרת, מופרדות בפסיק.
# Vite רץ בדרך כלל על http://localhost:5173
# אפשר * כדי לאפשר לכולם (פחות מאובטח)
CORS_ORIGINS=http://localhost:5173

# ---------------- אבטחה (לא חובה לשנות) ----------------
# כמה ניסיונות התחברות כושלים מותרים מכל כתובת IP ב-15 דקות
AUTH_RATE_LIMIT_MAX=20
# חוזק ההצפנה של סיסמאות (10 = ברירת מחדל טובה)
BCRYPT_ROUNDS=10

# ---------------- Cloudinary – העלאת תמונות (לא חובה) ----------------
# בלי שלושת אלה – כל האתר עובד, רק העלאת תמונה תחזיר שגיאה 503
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=recipes-app

# ---------------- מנהל ראשון (מומלץ בענן) ----------------
# בעליית השרת: אם המשתמש לא קיים – הוא נוצר כמנהל.
# סיסמה: לפחות 8 תווים, אות וספרה. בחרי סיסמה משלך!
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=מנהל האתר

# ---------------- נתוני הדגמה בענן (לא חובה) ----------------
# true = יוצר שני משתמשים לדוגמה (sara@example.com, david@example.com)
# עם הסיסמה DEMO_USER_PASSWORD, ומתכונים לדוגמה.
SEED_DEMO_DATA=false
DEMO_USER_PASSWORD=
